# Local-only Next.js environment. Copy to .env.local after `npm run local:start`.
# Never replace these values with hosted Supabase, Vercel, Render, or Upstash URLs.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=copy-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=copy-service-role-key-from-supabase-status

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Canonical knowledge ingestion/search. Keep search disabled until migration verification passes.
KNOWLEDGE_SEARCH_ENABLED=false
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
CRON_SECRET=skillarc-local-cron-secret

# Leave blank locally unless you explicitly configure a compatible REST gateway.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
